{
  "name": "relayqo-backend",
  "version": "1.0.0",
  "description": "Multi-tenant WhatsApp chatbot backend for Relayqo",
  "main": "index.js",
  "scripts": {
    "dev": "npx tsx src/app.ts",
    "dev:web": "npx tsx src/runtime/web.ts",
    "dev:worker": "npx tsx src/runtime/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "postbuild": "node scripts/copy-static-assets.cjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "portal:admin": "node scripts/portal-admin.cjs",
    "test:portal": "vitest run tests/integration/portal.spec.ts tests/integration/portal-browser.spec.ts --fileParallelism false --testTimeout 120000",
    "start": "node dist/src/app.js",
    "start:web": "node dist/src/runtime/web.js",
    "start:worker": "node dist/src/runtime/worker.js",
    "postinstall": "prisma generate",
    "db:dev": "npx prisma dev",
    "db:extract": "node scripts/extract-db.js",
    "tenant:enable-rag": "node scripts/enable-rag.js",
    "rag:benchmark": "node scripts/benchmark-rag.js",
    "rag:seed": "node scripts/seed-rag.js",
    "test": "vitest run --fileParallelism false --testTimeout 60000"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@whiskeysockets/baileys": "^6.7.24",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.6",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "jsdom": "^29.1.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@prisma/config": { "deepmerge-ts": "8.0.0" },
    "mysql2": "3.24.4"
  }
}
