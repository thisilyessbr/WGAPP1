# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# AI providers
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
# Optional emergency override: groq forces every account back to Groq; leave empty for each account's saved choice.
VOICE_TRANSCRIPTION_PROVIDER=

# Meta / WhatsApp Cloud API
META_APP_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v26.0
META_APP_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_CONFIG_ID=
WHATSAPP_GRAPH_API_VERSION=v26.0

# Generate each value independently with a cryptographically secure generator.
# Use at least 32 random bytes per value and never commit production values.
ENCRYPTION_KEY=
SIGNUP_STATE_SECRET=
AUTH_SECRET=

# Required when running the optional image or monitoring services.
# Set the same INTERNAL_SERVICE_TOKEN (at least 32 characters) on trusted backends only.
INTERNAL_SERVICE_TOKEN=
MONITORING_ADMIN_TOKEN=
IMAGE_SERVICE_URL=http://127.0.0.1:4002
MONITORING_SERVICE_URL=

# Comma-separated browser origins allowed to call the production API.
CORS_ORIGINS=https://app.relayqo.online,https://relayqo.online,https://www.relayqo.online

# QR sessions require a single dedicated, long-running worker. Keep disabled by default.
ENABLE_QR_CHANNELS=false

# Deliberately omitted: WHATSAPP_ACCESS_TOKEN.
# Every customer number must use its encrypted tenant-scoped credential.
DATABASE_POOL_MAX=5
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
WHATSAPP_QUEUE_WORKER_CONCURRENCY=2

# Client/admin portal: apply migrations and create an administrator before enabling.
PORTAL_ENABLED=false
PORTAL_PUBLIC_URL=http://localhost:3000
META_EMBEDDED_SIGNUP_ENABLED=false
# Development only. Production always requires actual email delivery.
PORTAL_DEV_AUTH_LINKS=false
# Skip verification/administrator email prompts on loopback origins only. Passwords still apply.
PORTAL_DEV_SKIP_EMAIL=false
PORTAL_MAIL_WEBHOOK_URL=
PORTAL_MAIL_WEBHOOK_SECRET=
# Simplest hosted option: verify relayqo.online in Resend, then set these two values.
# If configured, Resend is used before the generic webhook above.
RESEND_API_KEY=
PORTAL_MAIL_FROM=Relayqo <auth@relayqo.online>
# Start on a worker with access to the same database and embedding credentials.
PORTAL_DOCUMENT_WORKER=false
# Remind staff once when a customer has waited this long for a human (minutes, staff alert worker).
PORTAL_HANDOFF_REMINDER_MINUTES=15

# Operator alerts (worker): stuck queue, failing WhatsApp replies, AI outages, unanswered handoffs, spend near the limit.
# Any one destination turns them on. The webhook gets {"text","content"}: Slack and Discord incoming webhooks work,
# and so does Telegram: https://api.telegram.org/bot<token>/sendMessage?chat_id=<chat id>
OPERATOR_ALERT_WEBHOOK_URL=
# Comma-separated; sent through Resend (needs RESEND_API_KEY and PORTAL_MAIL_FROM).
OPERATOR_ALERT_EMAILS=
OPERATOR_ALERT_QUEUE_LAG_MINUTES=5
OPERATOR_ALERT_FAILED_DELIVERIES=3
OPERATOR_ALERT_AI_FAILURES=5
OPERATOR_ALERT_HANDOFF_MINUTES=15
OPERATOR_ALERT_SPEND_RATIO=0.8

# Broadcasts: approved templates to opted-in customers on Meta Cloud numbers. The worker sends only when enabled;
# STOP replies always opt customers out. Each broadcast needs admin approval unless this is set to false.
BROADCASTS_ENABLED=false
BROADCAST_REQUIRE_APPROVAL=true
BROADCAST_MAX_RECIPIENTS=1000
# Meta's per-message fee shown as an estimate (defaults: Morocco rates from 1 Oct 2026).
# BROADCAST_PRICE_USD_MARKETING=0.0414
# BROADCAST_PRICE_USD_UTILITY=0.023
