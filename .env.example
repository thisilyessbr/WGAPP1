# Main application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot?schema=public
ENABLE_DEV_CONTROL_CENTER=true

# AI providers
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=
LLM_MODEL=
USE_REAL_AI=false

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com

# Image service
IMAGE_SERVICE_PORT=3001

# Monitoring service
MONITORING_DATABASE_URL=
DIRECT_URL=
MONITORING_DATABASE_POOL_MAX=10
MONITORING_RETENTION_DAYS=30
MONITORING_HOST=127.0.0.1
MONITORING_PORT=3002
MONITORING_ADMIN_TOKEN=
