generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Tenant {
  portalMemberships PortalMembership[]
  portalProfiles PortalProfile[]
  id               String              @id @default(uuid())
  name             String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  accounts         Account[]
  conversations    Conversation[]
  customers        Customer[]
  knowledgeChunks  KnowledgeChunk[]
  knowledgeDocs    KnowledgeDocument[]
  knowledgeSources KnowledgeSource[]
  messages         Message[]
  config           TenantConfig?
  workflowSessions WorkflowSession[]
  products         Product[]
  leads            Lead[]
  whatsappNumbers  WhatsAppBusinessNumber[]
  whatsappJobs     WhatsAppMessageJob[]
  channelConnections ChannelConnection[]
  automationStates   ConversationAutomationState[]
  channelAuditEvents ChannelAuditEvent[]
  whatsappOutboundJobs WhatsAppOutboundJob[]
  whatsappDeliveryReceipts WhatsAppDeliveryReceipt[]
}

model TenantConfig {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Account {
  portalMemberships PortalMembership[]
  portalProfile PortalProfile?
  portalPublications PortalPublication[]
  portalUsageBuckets PortalUsageBucket[]
  portalUsageEntries PortalUsageEntry[]
  portalConnectionAttempts PortalConnectionAttempt[]
  portalDocuments PortalDocument[]
  id               String              @id @default(uuid())
  tenantId         String
  name             String
  enabled          Boolean             @default(true)
  config           Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations    Conversation[]
  knowledgeSources KnowledgeSource[]
  knowledgeDocs    KnowledgeDocument[]
  knowledgeChunks  KnowledgeChunk[]
  products         Product[]
  leads            Lead[]
  whatsappNumbers  WhatsAppBusinessNumber[]
  whatsappJobs     WhatsAppMessageJob[]
  channelConnections ChannelConnection[]
  automationStates   ConversationAutomationState[]
  channelAuditEvents ChannelAuditEvent[]
  whatsappOutboundJobs WhatsAppOutboundJob[]
  whatsappDeliveryReceipts WhatsAppDeliveryReceipt[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Customer {
  id            String         @id @default(uuid())
  tenantId      String
  externalId    String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  leads         Lead[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
}

model Conversation {
  id                         String            @id @default(uuid())
  tenantId                   String
  accountId                  String?
  customerId                 String
  status                     String            @default("ACTIVE")
  currentWorkflowId          String?
  currentStateId             String?
  contextData                Json              @default("{}")
  messageCount               Int               @default(0)
  automationCapped           Boolean           @default(false)
  humanRequested             Boolean           @default(false)
  humanRequestedAt           DateTime?
  postCompletionQuestionCount Int              @default(0)
  postCompletionCapped       Boolean           @default(false)
  version                    Int               @default(0)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  account                    Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  customer                   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant                     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages                   Message[]
  sessions                   WorkflowSession[]
  lastMerchantViewedAt       DateTime?
  automationState            ConversationAutomationState?
  outboundJobs               WhatsAppOutboundJob[]

  @@index([tenantId, customerId])
  @@index([tenantId, accountId, updatedAt(sort: Desc)])
  @@index([tenantId, accountId, status, updatedAt(sort: Desc)])
  @@index([tenantId, accountId, customerId])
}

model Message {
  id             String       @id @default(uuid())
  tenantId       String
  conversationId String
  role           String
  content        String
  externalId     String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([tenantId, conversationId])
  @@index([tenantId, conversationId, createdAt(sort: Asc)])
}

model WorkflowSession {
  id               String       @id @default(uuid())
  tenantId         String
  conversationId   String
  workflowId       String
  stateId          String
  stateHistory     String[]     @default([])
  collectedData    Json         @default("{}")
  humanRequested   Boolean?     @default(false)
  humanRequestedAt DateTime?
  status           String       @default("ACTIVE")
  contextData      Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId])
  @@index([tenantId, workflowId])
}

model KnowledgeSource {
  id        String              @id @default(uuid())
  tenantId  String
  accountId String?
  name      String
  type      String
  status    String              @default("PENDING")
  hash      String?
  metadata  Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  documents KnowledgeDocument[]
  account   Account?            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, accountId])
}

model KnowledgeDocument {
  id        String           @id @default(uuid())
  tenantId  String
  accountId String?
  sourceId  String
  title     String
  content   String
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  chunks    KnowledgeChunk[]
  account   Account?         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source    KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sourceId])
  @@index([tenantId, accountId])
}

model KnowledgeChunk {
  id         String                 @id @default(uuid())
  tenantId   String
  accountId  String?
  documentId String
  content    String
  metadata   Json?
  embedding  Unsupported("vector")?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  account    Account?               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  document   KnowledgeDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@index([tenantId, accountId])
}

model Product {
  id                    String           @id @default(uuid())
  tenantId              String
  accountId             String
  sku                   String
  name                  String
  nameLocalized         Json?
  description           String
  descriptionLocalized  Json?
  price                 Decimal          @db.Decimal(10, 2)
  currency              String           @default("USD")
  stock                 Int              @default(0)
  active                Boolean          @default(true)
  category              String?
  metadata              Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  account               Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants              ProductVariant[]

  @@unique([tenantId, accountId, sku])
  @@index([tenantId, accountId])
  @@index([tenantId, accountId, active])
  @@index([tenantId, accountId, category])
}

model ProductVariant {
  id            String    @id @default(uuid())
  productId     String
  sku           String
  name          String?
  size          String?
  color         String?
  priceOverride Decimal?  @db.Decimal(10, 2)
  stock         Int       @default(0)
  active        Boolean   @default(true)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
  @@index([productId])
  @@index([productId, active])
}

model Lead {
  id         String   @id @default(uuid())
  tenantId   String
  accountId  String
  customerId String
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, accountId, customerId])
  @@index([tenantId, accountId, status])
}

model WhatsAppBusinessNumber {
  id                  String   @id @default(uuid())
  tenantId            String
  accountId           String
  phoneNumberId       String   @unique
  wabaId              String?
  displayPhoneNumber  String?
  status              String   @default("CONNECTED")
  enabled             Boolean  @default(true)
  transport           String   @default("META_CLOUD")
  connectionId        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account    Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  connection ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([tenantId, accountId])
  @@index([tenantId, wabaId])
  @@index([connectionId])
}

model ChannelConnection {
  id                   String   @id @default(uuid())
  tenantId             String
  accountId            String
  provider             String   @default("META_CLOUD")
  connectionKey        String   @default("default")
  status               String   @default("PENDING")
  enabled              Boolean  @default(true)
  encryptedCredentials String?
  appId                String?
  wabaId               String?
  sessionKey           String?
  lastConnectedAt      DateTime?
  lastError            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  numbers  WhatsAppBusinessNumber[]
  sessionSecrets ChannelSessionSecret[]

  @@unique([tenantId, accountId, provider, connectionKey])
  @@index([tenantId, accountId])
  @@index([tenantId, provider])
}

model PortalUser {
  id String @id
  email String @unique
  name String
  passwordHash String
  role String @default("CLIENT")
  verifiedAt DateTime? @db.Timestamptz(6)
  disabled Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  memberships PortalMembership[]
  sessions PortalSession[]
  tokens PortalAuthToken[]
  connectionAttempts PortalConnectionAttempt[]
}

model PortalMembership {
  userId String
  tenantId String
  accountId String
  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([userId, accountId])
  @@index([accountId], map: "PortalMembership_account_idx")
}

model PortalSession {
  id String @id
  userId String
  tokenHash String @unique
  csrfToken String
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@index([userId], map: "PortalSession_user_idx")
  @@index([expiresAt], map: "PortalSession_expiry_idx")
}

model PortalAuthToken {
  tokenHash String @id
  userId String
  kind String
  expiresAt DateTime @db.Timestamptz(6)
  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model PortalPlan {
  id String @id
  name String
  description String @default("")
  price Decimal @default(0) @db.Decimal(12,2)
  currency String @default("MAD")
  published Boolean @default(false)
  revision Int @default(1)
  modules Json @default("[]")
  limits Json
  template Json @default("{}")
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  assignments PortalProfile[] @relation("PortalAssignedPlan")
  requests PortalProfile[] @relation("PortalRequestedPlan")
}

model PortalProfile {
  accountId String @id
  tenantId String
  status String @default("DRAFT")
  draft Json
  published Json?
  revision Int @default(1)
  publishedRevision Int @default(0)
  planId String?
  planSnapshot Json?
  requestedPlanId String?
  autoPublish Boolean @default(false)
  reviewNote String @default("")
  lockedFields Json @default("[]")
  editingFrozen Boolean @default(false)
  adminConfig Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  plan PortalPlan? @relation("PortalAssignedPlan", fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedPlan PortalPlan? @relation("PortalRequestedPlan", fields: [requestedPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([tenantId], map: "PortalProfile_tenant_idx")
}

model PortalPublication {
  id String @id
  accountId String
  revision Int
  data Json
  config Json
  actorId String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([accountId, revision])
}

model PortalAudit {
  id String @id
  actorId String
  accountId String?
  action String
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  @@index([accountId, createdAt(sort: Desc)], map: "PortalAudit_account_time_idx")
}

model PortalUsageBucket {
  accountId String
  period String
  messages Int @default(0)
  llmCalls Int @default(0)
  images Int @default(0)
  embeddings Int @default(0)
  spentMicros BigInt @default(0)
  reservedMicros BigInt @default(0)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@id([accountId, period])
}

model PortalUsageEntry {
  id String @id
  accountId String
  period String
  kind String
  dedupeKey String
  reservedMicros BigInt @default(0)
  chargedMicros BigInt?
  status String @default("RESERVED")
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([accountId, dedupeKey])
  @@index([accountId, createdAt(sort: Desc)], map: "PortalUsageEntry_account_time_idx")
}

model PortalConnectionAttempt {
  id String @id
  userId String
  accountId String
  stateToken String
  encryptedMetaToken String?
  metaCandidates Json?
  reconnectId String?
  status String @default("PENDING")
  expiresAt DateTime @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user PortalUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model PortalDocument {
  id String @id
  accountId String
  filename String
  hash String
  bytes Bytes
  size Int
  status String @default("PENDING")
  sourceId String?
  error String?
  leaseUntil DateTime? @db.Timestamptz(6)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  @@unique([accountId, hash])
  @@index([status, createdAt], map: "PortalDocument_jobs_idx")
}

model PortalThrottle {
  key String @id
  count Int
  resetsAt DateTime @db.Timestamptz(6)
}

model ChannelSessionSecret {
  id             String   @id @default(uuid())
  connectionId   String
  category       String
  secretKey      String
  encryptedValue String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  connection ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, category, secretKey])
  @@index([connectionId])
}

model ConversationAutomationState {
  id             String    @id @default(uuid())
  tenantId       String
  accountId      String?
  conversationId String    @unique
  botEnabled     Boolean   @default(true)
  humanTakeover  Boolean   @default(false)
  pausedUntil    DateTime?
  pauseReason    String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account      Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, accountId])
}

model ChannelAuditEvent {
  id             String   @id @default(uuid())
  tenantId       String
  accountId      String?
  connectionId   String?
  phoneNumberId  String?
  conversationId String?
  actorId        String?
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

model WhatsAppIdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model WhatsAppMessageJob {
  id            String    @id @default(uuid())
  wamid         String    @unique
  partitionKey  String
  tenantId      String
  accountId     String
  phoneNumberId String
  waId          String
  message       String
  timestamp     BigInt
  contactName   String?
  rawType       String    @default("text")
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3)
  lastError         String?
  response          String?
  outboundStatus    String?   @default("PENDING")
  outboundMessageId String?
  outboundError     String?
  availableAt       DateTime  @default(now())
  lockedAt      DateTime?
  lockedBy      String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account  Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, createdAt])
  @@index([status, partitionKey, createdAt])
  @@index([tenantId, accountId])
}

model WhatsAppOutboundJob {
  id                String    @id @default(uuid())
  dedupeKey         String    @unique
  tenantId          String
  accountId         String
  conversationId    String
  messageId         String    @unique
  phoneNumberId     String
  recipientWaId     String
  text              String
  status            String    @default("PENDING")
  attempts          Int       @default(0)
  maxAttempts       Int       @default(3)
  lastError         String?
  providerMessageId String?
  lockedAt          DateTime?
  lockedBy          String?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([tenantId, accountId])
}

model WhatsAppDeliveryReceipt {
  id                String   @id @default(uuid())
  dedupeKey         String   @unique
  tenantId          String
  accountId         String
  phoneNumberId     String
  providerMessageId String   // wamid
  recipientWaId     String
  status            String   // sent, delivered, read, failed
  providerTimestamp DateTime
  errorCode         Int?
  errorMessage      String?
  correlated        Boolean  @default(false)
  createdAt         DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([tenantId, accountId])
  @@index([providerMessageId, correlated])
  @@index([createdAt])
}
