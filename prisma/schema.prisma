generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model Tenant {
  id               String              @id @default(uuid())
  name             String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  accounts         Account[]
  conversations    Conversation[]
  customers        Customer[]
  knowledgeChunks  KnowledgeChunk[]
  knowledgeDocs    KnowledgeDocument[]
  knowledgeSources KnowledgeSource[]
  messages         Message[]
  config           TenantConfig?
  workflowSessions WorkflowSession[]
  products         Product[]
  leads            Lead[]
}

model TenantConfig {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Account {
  id               String              @id @default(uuid())
  tenantId         String
  name             String
  enabled          Boolean             @default(true)
  config           Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations    Conversation[]
  knowledgeSources KnowledgeSource[]
  knowledgeDocs    KnowledgeDocument[]
  knowledgeChunks  KnowledgeChunk[]
  products         Product[]
  leads            Lead[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Customer {
  id            String         @id @default(uuid())
  tenantId      String
  externalId    String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  leads         Lead[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
}

model Conversation {
  id                         String            @id @default(uuid())
  tenantId                   String
  accountId                  String?
  customerId                 String
  status                     String            @default("ACTIVE")
  currentWorkflowId          String?
  currentStateId             String?
  contextData                Json              @default("{}")
  messageCount               Int               @default(0)
  automationCapped           Boolean           @default(false)
  humanRequested             Boolean           @default(false)
  humanRequestedAt           DateTime?
  postCompletionQuestionCount Int              @default(0)
  postCompletionCapped       Boolean           @default(false)
  version                    Int               @default(0)
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
  account                    Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  customer                   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant                     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages                   Message[]
  sessions                   WorkflowSession[]

  @@index([tenantId, customerId])
  @@index([tenantId, accountId, customerId])
}

model Message {
  id             String       @id @default(uuid())
  tenantId       String
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId])
}

model WorkflowSession {
  id               String       @id @default(uuid())
  tenantId         String
  conversationId   String
  workflowId       String
  stateId          String
  stateHistory     String[]     @default([])
  collectedData    Json         @default("{}")
  humanRequested   Boolean?     @default(false)
  humanRequestedAt DateTime?
  status           String       @default("ACTIVE")
  contextData      Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  conversation     Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, conversationId])
  @@index([tenantId, workflowId])
}

model KnowledgeSource {
  id        String              @id @default(uuid())
  tenantId  String
  accountId String?
  name      String
  type      String
  status    String              @default("PENDING")
  hash      String?
  metadata  Json?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  documents KnowledgeDocument[]
  account   Account?            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, accountId])
}

model KnowledgeDocument {
  id        String           @id @default(uuid())
  tenantId  String
  accountId String?
  sourceId  String
  title     String
  content   String
  metadata  Json?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  chunks    KnowledgeChunk[]
  account   Account?         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  source    KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sourceId])
  @@index([tenantId, accountId])
}

model KnowledgeChunk {
  id         String                 @id @default(uuid())
  tenantId   String
  accountId  String?
  documentId String
  content    String
  metadata   Json?
  embedding  Unsupported("vector")?
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  account    Account?               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  document   KnowledgeDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@index([tenantId, accountId])
}

model Product {
  id                    String           @id @default(uuid())
  tenantId              String
  accountId             String
  sku                   String
  name                  String
  nameLocalized         Json?
  description           String
  descriptionLocalized  Json?
  price                 Decimal          @db.Decimal(10, 2)
  currency              String           @default("USD")
  stock                 Int              @default(0)
  active                Boolean          @default(true)
  category              String?
  metadata              Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  account               Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants              ProductVariant[]

  @@unique([tenantId, accountId, sku])
  @@index([tenantId, accountId])
  @@index([tenantId, accountId, active])
  @@index([tenantId, accountId, category])
}

model ProductVariant {
  id            String    @id @default(uuid())
  productId     String
  sku           String
  name          String?
  size          String?
  color         String?
  priceOverride Decimal?  @db.Decimal(10, 2)
  stock         Int       @default(0)
  active        Boolean   @default(true)
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, sku])
  @@index([productId])
  @@index([productId, active])
}

model Lead {
  id         String   @id @default(uuid())
  tenantId   String
  accountId  String
  customerId String
  status     String   @default("NEW")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, accountId, customerId])
  @@index([tenantId, accountId, status])
}
